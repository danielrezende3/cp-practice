{
    "files.exclude": {
        ".vscode": false,
        ".zed": true,
        ".build": true,
        ".gitignore": false,
        ".clang-format": true,
        ".clangd":true,
        "compile_flags":true,
        "bits/":true
    },
    "editor.renderLineHighlight": "all",
    "editor.cursorBlinking": "smooth",
    "editor.minimap.enabled": false,
    "editor.fontLigatures": true,
    "editor.formatOnSave": true,
    "editor.rulers": [
        80
    ]
}